# Upstash Redis (REST API) — from the Upstash console, or added automatically by
# the Vercel "Upstash Redis" integration.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Long random string that protects /api/admin. Leave unset to disable the endpoint.
# Generate one with: openssl rand -hex 32
ADMIN_TOKEN=
