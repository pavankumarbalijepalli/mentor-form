# Upstash Redis (REST API). The Vercel "Upstash for Redis" integration sets
# KV_REST_API_URL / KV_REST_API_TOKEN instead, which also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# PhonePe Payment Gateway: Business dashboard -> developer settings.
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
# "sandbox" while testing, "production" when live. Payments stay off until this is set.
PHONEPE_ENV=sandbox
# Where PhonePe sends customers back after paying: your site's public https address.
SITE_URL=
# The username/password you set on the webhook in the PhonePe dashboard.
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# Long random string that protects /api/admin. Leave unset to disable the endpoint.
# Generate one with: openssl rand -hex 32
ADMIN_TOKEN=
