# Upstash Redis (REST API). The Vercel "Upstash for Redis" integration sets
# KV_REST_API_URL / KV_REST_API_TOKEN instead, which also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Razorpay: Dashboard -> Account & Settings -> API keys. Start with TEST mode keys (rzp_test_...).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Any long random string; the same value goes in the webhook you create in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=

# Long random string that protects /api/admin. Leave unset to disable the endpoint.
# Generate one with: openssl rand -hex 32
ADMIN_TOKEN=
